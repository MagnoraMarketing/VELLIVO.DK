# Vellivo – miljøvariabler. Kopiér til .env.local til lokal udvikling.
# Commit ALDRIG rigtige nøgler. I produktion sættes værdierne i Vercel → Project → Settings → Environment Variables.

# Offentlig URL uden afsluttende skråstreg (bruges til kanoniske URL'er, sitemap og Stripe-returadresser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe – test mode under udvikling (sk_test_/whsec_), live mode i produktion (sk_live_/whsec_)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Vercel Blob (PRIVAT store) – ordrer, lagertællere, nyhedsbrev og kontaktbeskeder.
# Sættes automatisk af Vercel, når en Blob-store forbindes til projektet.
# Lokalt kan den udelades: så gemmes data i ./.data (kun udvikling).
BLOB_READ_WRITE_TOKEN=
